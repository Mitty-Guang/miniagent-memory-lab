# 复制本文件为 .env 并填入配置（.env 不要提交到 git）
# 任意 OpenAI 兼容服务均可；不填 key 时相关脚本会自动跳过真实调用

# 联网工具（http_get）的访问策略：
#   open      = 允许任意公网地址（默认；内网地址始终被拒绝，防 SSRF）
#   allowlist = 仅允许 WEB_ALLOWED_DOMAINS 中的域名
WEB_ACCESS=open
# WEB_ALLOWED_DOMAINS=wttr.in,api.open-meteo.com,api.github.com

# DeepSeek 官方 API（本项目实测使用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-flash

# 其他可选：
# 通义千问（DashScope 兼容模式）
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus
# OpenAI
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
